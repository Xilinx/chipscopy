{
  "extends": "_base/versal_standard_cores.json",
  "design_info": {
    "design_name": "chipscopy_ced",
    "description": "ChipScoPy CED (Configurable Example Design) for VMK365 with segmented programming",
    "hw_platform": "vmk365",
    "programming_flow": "segmented",
    "design_path": "vmk365/production/chipscopy_ced",
    "family": "versal",
    "device": "xc2vm3654",
    "board": "VMK365",
    "idcode": "0x04D98093",
    "boot_pdi_pattern": "*_boot.pdi",
    "pld_pdi_pattern": "*_pld.pdi"
  },
  "debug_cores": {
    "ibert_gtyp": {
      "enabled": true,
      "quad_names": [
        "Quad_204",
        "Quad_205",
        "Quad_206"
      ]
    },
    "ila": {
      "core_instances": [
        {
          "name": "chipscopy_i/counters/ila_slow_counter_0",
          "probe_prefix": "chipscopy_i/counters/slow_counter_0",
          "description": "ILA monitoring slow counter signals"
        }
      ]
    },
    "vio": {
      "core_instances": [
        {
          "name": "chipscopy_i/counters/vio_slow_counter_0",
          "probe_prefix": "chipscopy_i/counters/slow_counter_0",
          "description": "VIO controlling slow counter"
        }
      ]
    },
    "noc_perfmon": {
      "node_names": [
        "DDRMC5E_X0Y0",
        "NOC2_NMU512_X0Y2"
      ],
      "trigger_base_address": "0x80000000000"
    },
    "memory": {
      "memory_types": [
        "LPDDR5"
      ],
      "node_names": [
        "DDRMC5E_X0Y0"
      ]
    }
  },
  "supported_examples": [
    "ddr_example",
    "ila_advanced_trigger",
    "ila_and_vio",
    "ila_monitor_status",
    "link_and_eye_scan",
    "memory_example",
    "noc_perfmon",
    "noc_perfmon_basic",
    "program",
    "sptg_example",
    "sysmon_example",
    "sysmon_sync_example",
    "vio"
  ],
  "metadata": {
    "created_date": "2026-10-13",
    "version": "1.0.0",
    "maintainer": "AMD ChipScoPy Team",
    "last_updated": "2026-10-13",
    "notes": "VMK365 ChipScoPy CED with segmented programming (boot + PLD PDI), IBERT GTYP and LPDDR5X (LPDDR5) memory support."
  }
}
